#!/usr/bin/env bash
# memory — index | check | stale
# Works in both layouts of the memory seed:
#   repo mode:  store at <repo>/.memory/, skills at <repo>/.claude/skills/
#   store mode: a dedicated <system>-memory repo; store at its root, skills at skills/
set -euo pipefail
REPO="$(git rev-parse --show-toplevel)"
if [ -d "$REPO/.memory/context" ]; then
  MEM="$REPO/.memory"; SK="$REPO/.claude/skills"; REL=".memory/"
else
  MEM="$REPO"; SK="$REPO/skills"; REL=""
fi
SKREL="${SK#"$REPO"/}"
ACTORS='human|claude-code|bootstrap|dream'
TIERS='platform|project'

# fm <file> <key>: print a frontmatter value
fm() {
  awk -v k="$2" 'NR==1 && $0!="---" {exit}
    /^---$/ {n++; if (n==2) exit; next}
    n==1 && index($0, k":")==1 {sub("^"k":[ ]*", ""); print; exit}' "$1"
}

gen_index() {
  echo "# Memory index"
  echo
  echo "Generated by \`${REL}bin/memory index\`. Do not hand-edit: change a file's \`description:\` instead."
  echo "Read this at the start of any non-trivial task, then open only the files you need."
  echo
  echo "## Platform (applies everywhere)"
  echo
  (cd "$REPO" && find "${REL}context/platform" -name '*.md' 2>/dev/null | LC_ALL=C sort) | while read -r f; do
    echo "- \`$f\` · $(fm "$REPO/$f" description)"
  done
  echo
  echo "## Projects (one directory per repo)"
  echo
  (cd "$REPO" && find "${REL}context/projects" -name '*.md' 2>/dev/null | LC_ALL=C sort) | while read -r f; do
    echo "- \`$f\` · $(fm "$REPO/$f" description)"
  done
  echo
  echo "## Skills (open the SKILL.md when the description matches your task)"
  echo
  (cd "$REPO" && find "$SKREL" -name SKILL.md 2>/dev/null | LC_ALL=C sort) | while read -r f; do
    echo "- \`$f\` · $(fm "$REPO/$f" description)"
  done
  echo
  echo "## Rules"
  echo
  echo "- \`${REL}WRITE-RULES.md\` · what counts as memory, where it goes, line format"
  echo "- \`${REL}PERMISSIONS.md\` · which tier you may write directly"
  [ -f "$MEM/system.yaml" ] && echo "- \`${REL}system.yaml\` · the repos that belong to this system"
  return 0
}

check() {
  local fail=0 f k t bad hits secrets
  err() { echo "memory check: $*" >&2; fail=1; }

  while read -r f; do
    for k in name tier description last_verified; do
      [ -n "$(fm "$f" "$k")" ] || err "${f#"$REPO"/}: missing frontmatter '$k'"
    done
    t="$(fm "$f" tier)"
    [ -z "$t" ] || echo "$t" | grep -qE "^($TIERS)$" || err "${f#"$REPO"/}: tier '$t' is not one of $TIERS"
    bad="$(awk '/^---$/ {n++; next} n>=2' "$f" | grep -E '^- ' \
      | grep -vE "^- \[[0-9]{4}-[0-9]{2}-[0-9]{2}\] \[($ACTORS)\] " || true)"
    [ -z "$bad" ] || err "${f#"$REPO"/}: lines not in '- [YYYY-MM-DD] [actor] fact' format:"$'\n'"$bad"
  done < <(find "$MEM/context" -name '*.md')

  if [ -s "$MEM/ISOLATION.txt" ]; then
    hits="$(grep -rniF -f <(grep -vE '^[[:space:]]*(#|$)' "$MEM/ISOLATION.txt") \
      "$MEM/context" "$SK" 2>/dev/null || true)"
    [ -z "$hits" ] || err "isolation terms found (another system's content leaked in):"$'\n'"$hits"
  fi

  secrets="$(grep -rnE '(AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(api[_-]?key|secret|password|passwd|token)[[:space:]]*[:=][[:space:]]*[^[:space:]]{8,})' \
    "$MEM/context" "$SK" 2>/dev/null || true)"
  [ -z "$secrets" ] || err "possible secrets:"$'\n'"$secrets"

  diff -q <(gen_index) "$MEM/INDEX.md" >/dev/null 2>&1 \
    || err "INDEX.md is stale. Run: ${REL}bin/memory index"

  return $fail
}

stale() {
  local cutoff f lv
  cutoff="$(date -d '-60 days' +%F 2>/dev/null || date -v-60d +%F)"
  find "$MEM/context" -name '*.md' | LC_ALL=C sort | while read -r f; do
    lv="$(fm "$f" last_verified)"
    if [[ -z "$lv" || "$lv" < "$cutoff" ]]; then
      echo "${f#"$REPO"/} (last_verified: ${lv:-never})"
    fi
  done
}

case "${1:-}" in
  index) gen_index > "$MEM/INDEX.md"; echo "wrote ${REL}INDEX.md" ;;
  check) check && echo "memory check: ok" ;;
  stale) stale ;;
  *) echo "usage: ${REL}bin/memory {index|check|stale}" >&2; exit 2 ;;
esac
