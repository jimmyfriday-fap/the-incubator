{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incubator.local/schemas/discovery-turn.schema.json",
  "title": "DiscoveryTurn",
  "description": "One reply of the discovery engine: the updated draft spec, open questions and whether it is done.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draftSpec", "questions", "done"],
  "properties": {
    "draftSpec": {
      "type": "object",
      "description": "A partial incubator.json. Every value the model set must have a matching decisions[] entry."
    },
    "questions": {
      "type": "array",
      "items": {
        "title": "Question",
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "question", "options", "impact"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)*$"
          },
          "question": { "type": "string", "minLength": 1, "maxLength": 300 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 10 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "title": "QuestionOption",
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label", "recommended"],
              "properties": {
                "value": { "type": "string", "maxLength": 200 },
                "label": { "type": "string", "maxLength": 200 },
                "recommended": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "done": { "type": "boolean" }
  }
}
