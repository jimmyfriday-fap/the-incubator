  test:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: <%= it.h.action('actions/checkout') %>
      # why: the application under test lives in its own repository; a read-only token checks it out into app/.
      - uses: <%= it.h.action('actions/checkout') %>
        with:
          repository: ${{ github.repository_owner }}/<%= it.names.slug %>
          path: app
          token: ${{ secrets.APP_REPO_READ_TOKEN }}
      - uses: <%= it.h.action('actions/setup-node') %>
        with:
          node-version-file: .nvmrc
      - uses: <%= it.h.action('astral-sh/setup-uv') %>
        with:
          enable-cache: true
      - run: uv sync
      - run: node scripts/check.mjs full
      - run: uv run pytest -m e2e
