# Two stages: uv resolves and installs the app into a virtualenv, then a slim runtime runs it as a
# non-root user. Serves HTTP on port 8000; DATABASE_URL, APP_ENV and PORT come from the environment.
FROM python:<%= it.v.python %>-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
RUN pip install --no-cache-dir <%~ it.h.json('uv' + it.v.pypi.uv) %>
COPY pyproject.toml uv.lock* .python-version README.md ./
RUN uv sync --locked --no-dev --no-install-project || uv sync --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev --no-editable || uv sync --no-dev --no-editable

FROM python:<%= it.v.python %>-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 HOST=0.0.0.0 PORT=8000
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /app/.venv ./.venv
COPY db ./db
USER app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD ["python", "-c", "import os, sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8000') + '/health', timeout=2).status == 200 else 1)"]
CMD ["python", "-m", "<%= it.names.snake %>"]
