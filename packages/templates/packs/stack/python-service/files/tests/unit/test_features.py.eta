"""Features scaffolded by the Incubator answer 501 until they are implemented (TODO markers).

Also the registry check for Python: every feature in config/features.json has its module and its
scenario adapter under the snake_case name.
"""

import importlib.util
import json
from pathlib import Path

import pytest
from fastapi.testclient import TestClient

from <%= it.names.snake %>.app import build_app

from tests.scenario_contract import module_name

ROOT = Path(__file__).resolve().parents[2]
REGISTRY = json.loads((ROOT / "config" / "features.json").read_text(encoding="utf-8"))
ALL = [str(f["id"]) for f in REGISTRY["features"]]
FEATURES = [f for f in ALL if f != "health"]


def test_registry_lists_health() -> None:
    assert "health" in ALL


@pytest.mark.parametrize("feature", ALL)
def test_every_feature_has_a_module_and_an_adapter(feature: str) -> None:
    module = f"<%= it.names.snake %>.features.{module_name(feature)}"
    assert importlib.util.find_spec(module) is not None, f"missing module {module}"
    adapter = ROOT / "tests" / "adapters" / f"{module_name(feature)}.py"
    assert adapter.is_file(), f"missing adapter tests/adapters/{adapter.name}"


@pytest.mark.parametrize("feature", FEATURES)
def test_feature_answers_501_until_implemented(feature: str) -> None:
    response = TestClient(build_app()).get(f"/api/{feature}")
    assert response.status_code == 501
    assert response.json() == {"status": "todo", "feature": feature}
