# Local lane: the app plus Postgres. `docker compose up -d db` then `uv run python -m <%= it.names.snake %>.db`
# for a from-scratch database; `docker compose up --build` runs everything.
services:
  db:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: <%= it.names.snake %>
    ports:
      - '5432:5432'
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U app']
      interval: 5s
      retries: 10
  app:
    build: .
    environment:
      APP_ENV: ${APP_ENV:-local}
      DATABASE_URL: postgresql://app:app@db:5432/<%= it.names.snake %>
      PORT: '8000'
    ports:
      - '8000:8000'
    depends_on:
      db:
        condition: service_healthy
