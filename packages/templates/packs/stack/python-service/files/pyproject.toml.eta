<% const v = it.v.pypi; const dep = (n) => it.h.json(n + v[n]); const paired = it.spec.testing.home === 'paired-repo'; const pkg = it.names.snake; -%>
# Dependencies are declared here; `uv sync` resolves them into uv.lock (commit it after the first sync).
[project]
name = <%~ it.h.json(it.names.slug) %>
version = "0.1.0"
description = <%~ it.h.json(it.names.description) %>
readme = "README.md"
requires-python = ">=<%= it.v.python %>"
dependencies = [
  <%~ dep('fastapi') %>,
  <%~ dep('psycopg[binary]') %>,
  <%~ dep('uvicorn') %>,
]

[dependency-groups]
dev = [
<% if (!paired) { -%>
  <%~ dep('httpx2') %>,
<% } -%>
  <%~ dep('lefthook') %>,
  <%~ dep('mypy') %>,
  <%~ dep('pip-audit') %>,
<% if (!paired) { -%>
  <%~ dep('pytest') %>,
  <%~ dep('pytest-cov') %>,
<% } -%>
  <%~ dep('ruff') %>,
]

[build-system]
requires = [<%~ dep('hatchling') %>]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/<%= pkg %>"]

[tool.ruff]
line-length = 100
target-version = "py312"
extend-exclude = ["security/fixtures"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "S", "C4", "PT", "RUF", "N"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"src/<%= pkg %>/features/*.py" = ["RUF001", "RUF002", "RUF003"]
<% if (!paired) { -%>
"tests/**" = ["S101", "S105", "S106"]
"tests/e2e/**" = ["S101", "S603"]
<% } -%>

[tool.ruff.lint.isort]
known-first-party = ["<%= pkg %>"]
known-local-folder = ["tests"]

[tool.mypy]
python_version = "<%= it.v.python %>"
strict = true
warn_unreachable = true
mypy_path = "src"
explicit_package_bases = true
files = [<%~ paired ? '"src"' : '"src", "tests"' %>]
exclude = ["^security/fixtures/"]
<% if (!paired) { -%>

[tool.pytest.ini_options]
minversion = "9.0"
testpaths = ["tests"]
pythonpath = ["."]
addopts = ["-ra", "--strict-markers", "--strict-config"]
junit_family = "xunit2"
markers = [
  "unit: fast and isolated (no network, no database); every check:quick",
  "integration: needs DATABASE_URL (the Postgres service in CI)",
  "e2e: drives the HTTP server over real HTTP",
  "live: touches a deployed lane (INCUBATOR_LIVE=1 and BASE_URL)",
]

[tool.coverage.run]
source_pkgs = ["<%= pkg %>"]
branch = true
data_file = ".reports/.coverage"
omit = ["*/__main__.py"]

[tool.coverage.report]
show_missing = true
skip_covered = true
<% } -%>
