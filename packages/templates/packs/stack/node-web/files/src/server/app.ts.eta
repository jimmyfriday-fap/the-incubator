import Fastify, { type FastifyInstance } from 'fastify';
import { health, type HealthDeps } from '../features/health/index.js';
// <scaffold:feature-imports>
<% for (const f of it.features.filter((x) => !x.builtin)) { -%>
// @<%= f.id %>
import { register<%= it.h.pascal(f.id) %> } from '../features/<%= f.id %>/index.js';
<% } -%>
// </scaffold:feature-imports>

export interface AppDeps {
  health?: HealthDeps;
}

const STATUS_CODES = { ok: 200, degraded: 503, error: 400 } as const;

/** Builds the HTTP app. Routes for each feature are registered through the `routes` markers. */
export function buildApp(deps: AppDeps = {}): FastifyInstance {
  const app = Fastify({ logger: false });

  app.get('/health', async (request, reply) => {
    const { probe } = request.query as { probe?: string };
    const result = await health(probe === undefined ? {} : { probe }, deps.health);
    return reply.code(STATUS_CODES[result.status]).send(result);
  });

  // <scaffold:routes>
<% for (const f of it.features.filter((x) => !x.builtin)) { -%>
  // @<%= f.id %>
  register<%= it.h.pascal(f.id) %>(app);
<% } -%>
  // </scaffold:routes>

  return app;
}
