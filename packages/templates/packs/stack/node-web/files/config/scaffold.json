{
  "feature": {
    "files": [
      { "template": "scripts/scaffold/templates/feature.ts.tmpl", "dest": "src/features/{{FEATURE_ID}}/index.ts" },
      { "template": "scripts/scaffold/templates/adapter.ts.tmpl", "dest": "tests/adapters/{{FEATURE_ID}}.ts" }
    ],
    "markers": [
      { "file": "src/server/app.ts", "region": "feature-imports", "template": "scripts/scaffold/templates/import.ts.tmpl" },
      { "file": "src/server/app.ts", "region": "routes", "template": "scripts/scaffold/templates/route.ts.tmpl" }
    ]
  }
}
