# Local lane: the app plus Postgres. `docker compose up -d db` then `pnpm db:bootstrap` for a
# from-scratch database; `docker compose up --build` runs everything.
services:
  db:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: <%= it.names.snake %>
    ports:
      - '5432:5432'
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U app']
      interval: 5s
      retries: 10
  app:
    build: .
    environment:
      APP_ENV: local
      DATABASE_URL: postgres://app:app@db:5432/<%= it.names.snake %>
      PORT: '3000'
    ports:
      - '3000:3000'
    depends_on:
      db:
        condition: service_healthy
