<% const v = it.v.npm;
const pkg = {
  name: it.names.slug,
  version: '0.1.0',
  private: true,
  description: it.names.description,
  type: 'module',
  packageManager: `pnpm@${it.v.pnpm}`,
  engines: { node: '>=22.12 <23' },
  scripts: {
    dev: 'tsx watch src/server/main.ts',
    'dev:web': 'vite',
    build: 'tsc -p tsconfig.build.json && vite build',
    start: 'node dist/server/main.js',
    check: 'node scripts/check.mjs full',
    'check:quick': 'node scripts/check.mjs quick',
    test: 'vitest run --project unit',
    'test:profile': 'node scripts/test-profile.mjs',
    e2e: 'playwright test --project local',
    'db:bootstrap': 'node scripts/db/bootstrap.mjs',
    format: 'prettier --write .',
  },
  dependencies: {
    '@fastify/static': v['@fastify/static'],
    fastify: v.fastify,
    pg: v.pg,
    react: v.react,
    'react-dom': v['react-dom'],
  },
  devDependencies: {
    '@eslint/js': v['@eslint/js'],
    '@playwright/test': v['@playwright/test'],
    '@types/node': v['@types/node'],
    '@types/pg': v['@types/pg'],
    '@types/react': v['@types/react'],
    '@types/react-dom': v['@types/react-dom'],
    '@vitejs/plugin-react': v['@vitejs/plugin-react'],
    '@vitest/coverage-v8': v['@vitest/coverage-v8'],
    eslint: v.eslint,
    globals: v.globals,
    lefthook: v.lefthook,
    prettier: v.prettier,
    tsx: v.tsx,
    typescript: v.typescript,
    'typescript-eslint': v['typescript-eslint'],
    vite: v.vite,
    vitest: v.vitest,
  },
  pnpm: { onlyBuiltDependencies: ['esbuild', 'lefthook'] },
}; -%>
<%~ it.h.json(pkg) %>
