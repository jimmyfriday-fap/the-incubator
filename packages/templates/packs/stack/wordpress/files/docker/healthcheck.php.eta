<?php

// Container health check (Dockerfile HEALTHCHECK and compose.yaml): healthy when the REST health
// route answers 200, or while a fresh database still redirects to the WordPress installer.

declare(strict_types=1);

$context = stream_context_create(['http' => ['ignore_errors' => true, 'follow_location' => 0, 'timeout' => 5]]);
$handle = @fopen(<%~ it.h.phpStr('http://127.0.0.1/?rest_route=/' + it.names.slug + '/v1/health') %>, 'r', false, $context);
if ($handle === false) {
    exit(1);
}
$meta = stream_get_meta_data($handle);
fclose($handle);

$status = 0;
$location = '';
foreach ($meta['wrapper_data'] ?? [] as $header) {
    if (!is_string($header)) {
        continue;
    }
    if (preg_match('#^HTTP/\S+\s+(\d{3})#', $header, $m) === 1) {
        $status = (int) $m[1];
    } elseif (stripos($header, 'location:') === 0) {
        $location = $header;
    }
}

exit($status === 200 || ($status >= 300 && $status < 400 && str_contains($location, 'install.php')) ? 0 : 1);
