<% const text = (s) => s.split('*/').join('* /'); -%>
<?php

/**
 * Plugin Name:       <%= text(it.names.title) %>
 * Description:       <%= text(it.names.description || it.names.title) %>
 * Version:           0.1.0
 * Requires at least: 6.6
 * Requires PHP:      <%= it.v.php %>
 * License:           GPL-2.0-or-later
 * License URI:       https://www.gnu.org/licenses/gpl-2.0.html
 * Text Domain:       <%= it.names.slug %>
 */

declare(strict_types=1);

if (!defined('ABSPATH')) {
    exit;
}

if (is_readable(__DIR__ . '/vendor/autoload.php')) {
    require_once __DIR__ . '/vendor/autoload.php';
} else {
    // No vendor/ (a bare checkout): the plugin has no runtime dependencies, so map src/ directly.
    spl_autoload_register(static function (string $class): void {
        $prefix = <%~ it.h.phpStr(it.names.pascal + '\\') %>;
        if (str_starts_with($class, $prefix)) {
            $file = __DIR__ . '/src/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
            if (is_readable($file)) {
                /** @psalm-suppress UnresolvableInclude a PSR-4 path computed from the class name */
                require_once $file;
            }
        }
    });
}

\<%= it.names.pascal %>\Plugin::boot();
