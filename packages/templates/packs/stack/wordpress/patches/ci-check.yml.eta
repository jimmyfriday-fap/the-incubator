  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: <%= it.h.action('actions/checkout') %>
      - uses: <%= it.h.action('shivammathur/setup-php') %>
        with:
          php-version: '<%= it.v.php %>'
          tools: composer:v2
          coverage: pcov
      # The guard toolkit (scripts/check.mjs, scripts/guard/) is plain Node.
      - uses: <%= it.h.action('actions/setup-node') %>
        with:
          node-version-file: .nvmrc
      - run: composer install --no-interaction --no-progress --prefer-dist
      - run: node scripts/check.mjs full
      # why: triage records the failure through the tracker adapter; continue-on-error means it can never change the verdict.
      - name: CI failure triage
        if: failure()
        continue-on-error: true
        run: node scripts/agent/tracker.mjs ci-failure --job check --run "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
