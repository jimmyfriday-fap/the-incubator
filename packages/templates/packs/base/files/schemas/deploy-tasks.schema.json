{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incubator.local/schemas/deploy-tasks.schema.json",
  "title": "DeployTasks",
  "description": "Post-deploy tasks run by scripts/run-deploy-tasks.mjs (dry run unless --yes).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "env", "idempotent", "runOnce", "timeout", "command"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "env": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["staging", "prod"] }
          },
          "idempotent": { "type": "boolean" },
          "runOnce": { "type": "boolean" },
          "timeout": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "argv array, run without a shell"
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
