<% const node = it.spec.stack.pack === 'node-web'; -%>
name: deploy-production

# No push trigger: promote-to-production.yml dispatches this after merging into <%= it.spec.lanes.branches.prod %>.
on:
  workflow_dispatch:
    inputs:
      promote_run:
        description: Run id of the promote-to-production run that dispatched this deploy
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: deploy-production
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: [self-hosted, incubator-<%= it.names.slug %>]
    environment: production
    timeout-minutes: 30
    env:
      APP_ENV: prod
      DEPLOY_ROOT: ${{ vars.DEPLOY_ROOT }}
      PROD_URL: ${{ vars.PROD_URL }}
    steps:
      # why: only the prod branch may deploy to production.
      - if: github.ref != 'refs/heads/<%= it.spec.lanes.branches.prod %>'
        run: |
          echo "deploy-production must run on <%= it.spec.lanes.branches.prod %>, not $GITHUB_REF"
          exit 2
      - uses: <%= it.h.action('actions/checkout') %>
      - run: node scripts/deploy/preflight.mjs --require DEPLOY_ROOT,PROD_URL
<% if (node) { -%>
      - uses: <%= it.h.action('pnpm/action-setup') %>
      # why: production dependencies only; the release directory is what PM2 runs.
      - run: |
          pnpm install --frozen-lockfile
          pnpm build
          pnpm prune --prod
<% } -%>
      - run: node scripts/deploy/vps-release.mjs --root "$DEPLOY_ROOT/prod" --sha "$GITHUB_SHA" --from . --keep 5
<% if (node) { -%>
      - run: pm2 startOrReload "$DEPLOY_ROOT/prod/current/deploy/ecosystem.config.cjs" --env production
<% } else { -%>
      - run: docker compose -f "$DEPLOY_ROOT/prod/current/compose.yaml" -p <%= it.names.slug %>-prod up -d --build --wait
<% } -%>
      - run: node scripts/run-deploy-tasks.mjs --env prod --sha "$GITHUB_SHA" --yes --log "$DEPLOY_ROOT/deploy-tasks.log.jsonl"
      - run: node scripts/deploy/smoke.mjs --url "$PROD_URL" --attempts 10
