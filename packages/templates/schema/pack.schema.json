{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incubator.local/schemas/pack.schema.json",
  "title": "PackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "appliesWhen", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^(base|(stack|deploy|test-home)/[a-z0-9-]+)$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "appliesWhen": { "type": "string" },
    "requires": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "dest"],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^files/[^\\\\]*$",
            "not": { "pattern": "(^|/)\\.\\.(/|$)" }
          },
          "dest": {
            "type": "string",
            "not": { "pattern": "^(/|[A-Za-z]:)|(^|/)\\.\\.(/|$)|\\\\" }
          },
          "when": { "type": "string" },
          "each": { "type": "string" },
          "as": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$" },
          "mode": { "enum": ["0644", "0755"] },
          "role": { "type": "string" },
          "vars": { "type": "object" }
        }
      }
    },
    "markerPatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "region", "entries"],
        "properties": {
          "file": { "type": "string" },
          "region": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "when": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
                "src": { "type": "string", "pattern": "^patches/" },
                "text": { "type": "string" },
                "when": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "jsonPatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "ops"],
        "properties": {
          "file": { "type": "string" },
          "when": { "type": "string" },
          "ops": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "pointer"],
              "properties": {
                "op": { "enum": ["set", "merge", "append-unique", "remove"] },
                "pointer": { "type": "string" },
                "value": {},
                "valueSrc": { "type": "string", "pattern": "^patches/" },
                "when": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "relocate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "to"],
        "properties": {
          "role": { "type": "string" },
          "to": { "type": "string", "pattern": "^@[a-z]+/$" },
          "when": { "type": "string" }
        }
      }
    },
    "canonical": { "type": "string" }
  }
}
