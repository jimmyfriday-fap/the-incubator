        "id": "reading-log",
        "summary": "Members log the books they are reading, with status such as reading or finished",
        "lane": "enhancement/new"
      },
      {
        "id": "club-shelf",
        "summary": "A shared view of what every member is currently reading",
        "lane": "ui/feature"
      },
      {
        "id": "next-book-vote",
        "summary": "Members nominate candidate books and vote on the club's next read, with a visible result",
        "lane": "enhancement/new"
      }
    ]
  },
  "platform": "web",
  "stack": {
    "pack": "node-web",
    "framework": "fastify-react",
    "database": "postgres",
    "auth": "session",
