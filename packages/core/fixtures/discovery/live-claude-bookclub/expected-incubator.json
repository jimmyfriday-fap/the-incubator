      "Book club member who logs current reads and votes on the next book",
      "Club organizer who opens and closes votes for the next book"
    ],
    "coreFeatures": [
      {
        "id": "member-accounts",
        "summary": "Members join the club and sign in so logs and votes are tied to a person",
        "lane": "enhancement/new"
