{
  "$schema": "../../../schemas/scenario.schema.json",
  "id": "validation-update-has-memory",
  "feature": "add-memory",
  "title": "An update run in a repository that already keeps memory records target mode and makes no offer",
  "tags": ["validation"],
  "seed": {},
  "context": {},
  "mocks": {
    "ai": []
  },
  "stages": [
    {
      "name": "update",
      "input": {
        "agent": "edit",
        "update": true,
        "hasMemory": true
      },
      "assertions": [
        {
          "path": "memoryMode",
          "op": "eq",
          "value": "target"
        },
        {
          "path": "memoryOffered",
          "op": "eq",
          "value": false
        }
      ]
    }
  ]
}
