{
  "$schema": "../../../schemas/scenario.schema.json",
  "id": "fault-crash-after-commit",
  "feature": "local-folder",
  "title": "A crash right after the commit resumes without a second commit",
  "tags": ["fault"],
  "seed": {},
  "context": {},
  "mocks": {
    "ai": []
  },
  "stages": [
    {
      "name": "folder",
      "input": {
        "mode": "new",
        "commit": "commit",
        "push": "push",
        "crash": {
          "at": "commit",
          "method": "commit",
          "when": "after"
        }
      },
      "assertions": [
        {
          "path": "state",
          "op": "eq",
          "value": "DONE"
        },
        {
          "path": "resumes",
          "op": "gte",
          "value": 3
        },
        {
          "path": "commits",
          "op": "eq",
          "value": 1
        },
        {
          "path": "prs",
          "op": "eq",
          "value": 1
        }
      ]
    }
  ]
}
