{
  "$schema": "../../../schemas/scenario.schema.json",
  "id": "fault-crash-after-commit",
  "feature": "enhance-existing",
  "title": "A crash right after the first commit resumes to two commits and one pull request",
  "tags": ["fault"],
  "seed": {
    "fixtures": "export-orders",
    "repo": "bare-node"
  },
  "context": {},
  "mocks": {
    "ai": ["packages/core/fixtures/enhance/export-orders"]
  },
  "stages": [
    {
      "name": "enhance",
      "input": {
        "request": "Kitchen staff need to export the orders list as a CSV file at the end of the day.",
        "withGaps": true,
        "crash": {
          "kind": "git",
          "method": "commit",
          "when": "after"
        }
      },
      "assertions": [
        {
          "path": "state",
          "op": "eq",
          "value": "DONE"
        },
        {
          "path": "resumes",
          "op": "gte",
          "value": 1
        },
        {
          "path": "prs",
          "op": "eq",
          "value": 1
        },
        {
          "path": "commits",
          "op": "eq",
          "value": 2
        }
      ]
    }
  ]
}
