{
  "name": "@incubator/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell embedding the engine and web UI.",
  "type": "module",
  "exports": {
    ".": {
      "@incubator/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@incubator/core": "workspace:*",
    "@incubator/runtime": "workspace:*",
    "@incubator/web": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "main": "app/dist/main.mjs",
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never --dir",
    "dist:test": "node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never --dir -c.directories.app=app-test -c.directories.output=release-test"
  }
}
