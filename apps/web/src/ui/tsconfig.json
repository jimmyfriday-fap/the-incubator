{
  "//": "The browser UI: DOM types and JSX, checked on its own (the root tsconfig excludes it).",
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../api-types.ts"]
}
