{
  "incubatorVersion": "1.0",
  "mode": "greenfield",
  "project": {
    "name": "The Incubator",
    "slug": "the-incubator",
    "description": "Turns a plain-English idea and/or an existing repository into a canonical GitHub repository.",
    "owner": {
      "type": "user",
      "login": ""
    },
    "visibility": "private"
  },
  "intent": {
    "narrative": "",
    "personas": ["developer starting a project", "maintainer adopting a repository"],
    "coreFeatures": [
      {
        "id": "exit-codes",
        "summary": "Every CLI command honours the 0/1/2/130 exit-code contract.",
        "lane": "enhancement/new"
      },
      {
        "id": "discovery",
        "summary": "A narrative becomes an approved incubator.json with at most 5 questions per round and 2 rounds.",
        "lane": "enhancement/new"
      }
    ]
  },
  "platform": "cli",
  "stack": {
    "pack": "node-lib",
    "framework": "typescript-lib",
    "database": "none",
    "auth": "none",
    "packageManager": "pnpm"
  },
  "lanes": {
    "environments": ["local", "staging", "prod"],
    "branches": {
      "staging": "main",
      "prod": "production"
    },
    "workLanes": [
      "workspace",
      "security",
      "support/existing",
      "testing",
      "infra",
      "enhancement/existing",
      "enhancement/new",
      "ui/fix",
      "ui/feature"
    ]
  },
  "deploy": {
    "target": "package-release",
    "staging": {
      "host": "",
      "tailnetOnly": false
    },
    "prod": {
      "host": ""
    }
  },
  "testing": {
    "home": "in-repo",
    "profiles": ["quick", "full", "chaos", "hardening", "release", "live"],
    "coverageThreshold": 80,
    "completenessThreshold": 70,
    "e2e": "none"
  },
  "security": {
    "scanners": ["semgrep", "trivy", "gitleaks"],
    "policyGate": "HIGH",
    "centralRig": {
      "enabled": false,
      "repo": ""
    }
  },
  "agents": {
    "primary": "claude",
    "also": ["copilot", "cursor"],
    "runCeilings": {
      "turns": 60,
      "toolCalls": 400,
      "minutes": 45,
      "usd": 10
    },
    "deniedActions": [
      "force-push",
      "rewrite-history",
      "delete-or-skip-test",
      "disable-or-weaken-gate",
      "quarantine-without-owner-and-expiry",
      "edit-incubator-lock",
      "commit-secrets",
      "absolute-machine-paths",
      "plan-files-at-repo-root",
      "shell-true-subprocess"
    ],
    "humanOnlyActions": [
      "promote-to-production",
      "rollback-production",
      "rotate-secrets",
      "edit-accepted-risks",
      "contracts-pin",
      "change-run-ceilings",
      "merge-to-production"
    ]
  },
  "tracker": {
    "type": "local"
  },
  "templates": {
    "packs": []
  },
  "source": {
    "type": "none",
    "ref": ""
  },
  "gapReport": [],
  "decisions": [
