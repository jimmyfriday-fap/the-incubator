{
  "//": "Typecheck-only view of the whole workspace (sources + tests), resolving sibling packages to src via the @incubator/source condition.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "customConditions": ["@incubator/source"]
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["**/node_modules", "**/dist", "apps/web/src/ui/**"]
}
